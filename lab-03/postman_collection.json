{
  "info": {
    "_postman_id": "b3e045a1-7c91-49b8-a621-0a69a92a54bf",
    "name": "Lab 03 - Books REST API Test Collection",
    "description": "Comprehensive test collection covering success and failure cases for Lab 3: REST API, query parameters, validation, and debugging.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Get all books (default limit 10)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/books/",
          "host": ["{{base_url}}"],
          "path": ["books", ""]
        }
      }
    },
    {
      "name": "2. Search by title",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/books/?search_q=the",
          "host": ["{{base_url}}"],
          "path": ["books", ""],
          "query": [
            { "key": "search_q", "value": "the" }
          ]
        }
      }
    },
    {
      "name": "3. Sort by price, highest first, 3 books",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/books/?order_by=price&order=DESC&limit=3",
          "host": ["{{base_url}}"],
          "path": ["books", ""],
          "query": [
            { "key": "order_by", "value": "price" },
            { "key": "order", "value": "DESC" },
            { "key": "limit", "value": "3" }
          ]
        }
      }
    },
    {
      "name": "4. Price range 300 to 400",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/books/?min_price=300&max_price=400",
          "host": ["{{base_url}}"],
          "path": ["books", ""],
          "query": [
            { "key": "min_price", "value": "300" },
            { "key": "max_price", "value": "400" }
          ]
        }
      }
    },
    {
      "name": "5. Pagination: skip 2, take 2",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/books/?limit=2&offset=2",
          "host": ["{{base_url}}"],
          "path": ["books", ""],
          "query": [
            { "key": "limit", "value": "2" },
            { "key": "offset", "value": "2" }
          ]
        }
      }
    },
    {
      "name": "6. Get one book",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/books/4/",
          "host": ["{{base_url}}"],
          "path": ["books", "4", ""]
        }
      }
    },
    {
      "name": "7. Add a book (expect 201)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Python Basics\",\n  \"author\": \"John\",\n  \"price\": 350,\n  \"pages\": 250\n}"
        },
        "url": {
          "raw": "{{base_url}}/books/",
          "host": ["{{base_url}}"],
          "path": ["books", ""]
        }
      }
    },
    {
      "name": "8. Update a book (expect 200)",
