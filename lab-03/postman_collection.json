        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Python Programming\",\n  \"author\": \"John\",\n  \"price\": 450,\n  \"pages\": 300\n}"
        },
        "url": {
          "raw": "{{base_url}}/books/11/",
          "host": ["{{base_url}}"],
          "path": ["books", "11", ""]
        }
      }
    },
